{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    "declaration": false,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"],
      "@orca/sdk": ["../sdk/src/index.ts"],
      "provider": ["../@mf-types/provider"],
      "*": ["./@mf-types/*"]
    }
  },
  "include": ["src", "../sdk/src", "../@mf-types/**/*.d.ts"],
  "exclude": ["**/node_modules"]
}
