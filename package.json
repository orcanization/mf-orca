{
  "name": "@orca/workspacese",
  "workspaces": ["app", "sdk"],
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "lint-staged": "~13.1.0",
    "simple-git-hooks": "^2.11.1"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --files-ignore-unknown=true"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  }
}
